# Managed by Ansible (litellm_proxy). Do not edit manually.
LITELLM_MASTER_KEY={{ litellm_proxy_master_key }}
LITELLM_SALT_KEY={{ litellm_proxy_salt_key }}
DATABASE_URL=postgresql://litellm:{{ litellm_proxy_db_password }}@db:5432/litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD={{ litellm_proxy_db_password }}
POSTGRES_DB=litellm
{% for m in litellm_proxy_models %}
BACKEND_KEY_{{ loop.index0 }}={{ m.api_key }}
{% endfor %}
