global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'node_exporter'
    static_configs:
      - targets:
{% for target in plg_monitoring_node_exporter_targets %}
          - '{{ target }}'
{% endfor %}

  - job_name: 'nvidia_gpu_exporter'
    static_configs:
      - targets:
{% for target in plg_monitoring_gpu_exporter_targets %}
          - '{{ target }}'
{% endfor %}
