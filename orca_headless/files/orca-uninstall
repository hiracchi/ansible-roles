#!/usr/bin/env bash
# ==============================================================================
# orca-uninstall: Stop and uninstall Orca headless service and files
# ==============================================================================
set -euo pipefail

SERVICE_NAME="orca-serve.service"
INSTALL_DIR="/opt/orca"
PAIRING_SCRIPT="/usr/local/bin/orca-pairing-info"
UNINSTALL_SCRIPT="/usr/local/bin/orca-uninstall"
ORCA_USER="orca"
ORCA_GROUP="orca"

show_help() {
  cat <<'EOF'
Usage: sudo orca-uninstall [OPTIONS]

Stop and remove Orca headless runtime, systemd service, and orca user.

Options:
  -y, --yes       Execute without confirmation prompt
  -h, --help      Show this help message
EOF
}

ASSUME_YES=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    -y|--yes)
      ASSUME_YES=true
      shift
      ;;
    -h|--help)
      show_help
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      show_help >&2
      exit 1
      ;;
  esac
done

if [[ "$(id -u)" -ne 0 ]]; then
  echo "Error: This script must be run as root (or with sudo)." >&2
  exit 1
fi

if [[ "${ASSUME_YES}" != "true" ]]; then
  echo "This will stop and remove Orca headless runtime, including:"
  echo "  - systemd service (${SERVICE_NAME})"
  echo "  - Install directory (${INSTALL_DIR})"
  echo "  - Helper scripts (${PAIRING_SCRIPT})"
  echo "  - System user and home directory (${ORCA_USER})"
  echo
  read -r -p "Are you sure you want to proceed? [y/N] " response
  case "${response}" in
    [yY][eE][sS]|[yY])
      ;;
    *)
      echo "Aborted."
      exit 0
      ;;
  esac
fi

echo "Stopping and disabling ${SERVICE_NAME}..."
if systemctl is-active --quiet "${SERVICE_NAME}" 2>/dev/null; then
  systemctl stop "${SERVICE_NAME}" || true
fi
if systemctl is-enabled --quiet "${SERVICE_NAME}" 2>/dev/null; then
  systemctl disable "${SERVICE_NAME}" || true
fi

SERVICE_FILE="/etc/systemd/system/${SERVICE_NAME}"
if [[ -f "${SERVICE_FILE}" ]]; then
  echo "Removing service unit file ${SERVICE_FILE}..."
  rm -f "${SERVICE_FILE}"
  systemctl daemon-reload
  systemctl reset-failed "${SERVICE_NAME}" 2>/dev/null || true
fi

if [[ -d "${INSTALL_DIR}" ]]; then
  echo "Removing install directory ${INSTALL_DIR}..."
  rm -rf "${INSTALL_DIR}"
fi

if [[ -f "${PAIRING_SCRIPT}" ]]; then
  echo "Removing pairing helper script ${PAIRING_SCRIPT}..."
  rm -f "${PAIRING_SCRIPT}"
fi

echo "Disabling lingering for user ${ORCA_USER}..."
if loginctl show-user "${ORCA_USER}" >/dev/null 2>&1; then
  loginctl disable-linger "${ORCA_USER}" 2>/dev/null || true
fi
if [[ -f "/var/lib/systemd/linger/${ORCA_USER}" ]]; then
  rm -f "/var/lib/systemd/linger/${ORCA_USER}"
fi

if id "${ORCA_USER}" >/dev/null 2>&1; then
  echo "Removing system user and home directory for ${ORCA_USER}..."
  # Kill any remaining processes owned by orca user
  pkill -u "${ORCA_USER}" 2>/dev/null || true
  sleep 1
  userdel -r "${ORCA_USER}" 2>/dev/null || userdel -f "${ORCA_USER}" 2>/dev/null || true
fi

if getent group "${ORCA_GROUP}" >/dev/null 2>&1; then
  groupdel "${ORCA_GROUP}" 2>/dev/null || true
fi

echo "Orca headless runtime has been successfully stopped and uninstalled."

if [[ -f "${UNINSTALL_SCRIPT}" && "${BASH_SOURCE[0]}" == "${UNINSTALL_SCRIPT}" ]]; then
  rm -f "${UNINSTALL_SCRIPT}"
fi
